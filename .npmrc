# Reintentos ante cortes de red. El despliegue ya no es Heroku (ahora EC2), pero
# estos valores siguen siendo útiles en conexiones lentas.
maxsockets=1
fetch-retries=3
fetch-retry-mintimeout=5000
fetch-retry-maxtimeout=60000

# NO reactivar `prefer-offline` / `cache-min`: hacían que npm resolviera las
# versiones desde la caché local en vez del registro, así que `npm install
# <pkg>@<version>` fallaba con ETARGET para versiones que sí existen y, peor,
# las actualizaciones de seguridad pasaban desapercibidas. Detectado en el
# mantenimiento del 2026-08-31 al subir Strapi a 5.52.2.
